{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Go: Analytics API",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/apps/api/cmd/api",
      "cwd": "${workspaceFolder}/apps/api",
      "env": {
        "API_ENV": "development",
        "DATABASE_URL": "postgresql://real_estate_api:real_estate_api@localhost:5432/real_estate",
        "API_ALLOWED_ORIGINS": "http://localhost:5173,http://localhost:3000",
        "LOG_LEVEL": "debug"
      }
    },
    {
      "name": "Python: ETL CLI",
      "type": "debugpy",
      "request": "launch",
      "module": "real_estate_etl.cli",
      "cwd": "${workspaceFolder}",
      "args": [
        "refresh-all-data",
        "--workers",
        "6",
        "--verbose"
      ],
      "env": {
        "DATABASE_URL": "postgresql://real_estate:real_estate@localhost:5432/real_estate"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
